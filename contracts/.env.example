# Deployer / initial governance key (no 0x prefix issues: include the 0x)
PRIVATE_KEY=

# Horizen appchain RPC (defaults baked into hardhat.config.js)
HORIZEN_TESTNET_RPC_URL=https://horizen-rpc-testnet.appchain.base.org
HORIZEN_MAINNET_RPC_URL=

# The agent enclave's trading key. Defaults to the deployer for local bring-up.
AGENT_ADDRESS=

# Use an existing ERC20 as the vault asset instead of deploying a mock (required on mainnet).
VAULT_ASSET=
